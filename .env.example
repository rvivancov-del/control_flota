# Variables compartidas por docker-compose (base de datos)
# POSTGRES_USER / POSTGRES_PASSWORD son las del superusuario de la instancia, que ya no usa ningún servicio:
# cada servicio se conecta con su propio rol (flota_auth, flota_fleet) definido en su .env.
POSTGRES_USER=flota
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=flota_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
