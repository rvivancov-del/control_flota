# Gateway de producción: mismo nginx que el de desarrollo, sin privilegios de administrador (RNF-02) y
# con la configuración de infra/nginx/nginx.prod.conf ya incluida en la imagen (no como volumen, para
# que la imagen que se construye sea la misma que se despliega). El certificado TLS SÍ se monta como
# volumen en tiempo de ejecución (docker-compose.prod.yml): una clave privada no va horneada en una
# imagen que se pueda empujar a un registro.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY nginx.prod.conf /etc/nginx/nginx.conf

EXPOSE 8080 8443

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null --no-check-certificate https://127.0.0.1:8443/ || exit 1
