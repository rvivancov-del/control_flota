# Imagen de producción del frontend: compila la SPA (tsc + vite build) y la sirve con nginx, en vez
# del servidor de desarrollo de Vite (frontend/Dockerfile, para docker-compose.yml). La usa
# docker-compose.prod.yml, con la RAÍZ del repositorio como contexto de compilación (no solo
# frontend/): esta etapa final necesita infra/nginx/frontend.conf, fuera de la carpeta frontend/.
FROM node:20-alpine AS build
WORKDIR /app
COPY frontend/package.json frontend/package-lock.json* ./
RUN npm install
COPY frontend/. .
# VITE_API_BASE_URL se resuelve en tiempo de compilación (Vite la incrusta en el bundle): en
# producción el frontend y la API comparten origen a través del gateway, así que el valor por
# defecto de services/reportsApi.ts y apiClient.ts (mismo host, puerto 8080) ya no aplica -- se fija
# aquí a rutas relativas, y el gateway (nginx.prod.conf) enruta /api/* a los tres servicios.
ENV VITE_API_BASE_URL=/api
RUN npm run build

# nginx sin privilegios de administrador (RNF-02): todo el proceso, no solo los workers, corre como un
# usuario sin root; por eso escucha en el puerto 8080 (no root) y no en el 80.
FROM nginxinc/nginx-unprivileged:1.27-alpine
COPY --from=build /app/dist /usr/share/nginx/html
COPY infra/nginx/frontend.conf /etc/nginx/conf.d/default.conf

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -q -O - http://127.0.0.1:8080/health || exit 1
