# Plantilla para docker-compose.prod.yml (RNF-02: sin secretos por defecto fuera de desarrollo).
# Copie este archivo a .env.prod (que NUNCA se versiona, ver .gitignore) y reemplace cada valor por uno
# real. docker-compose.prod.yml se niega a arrancar si falta cualquiera de estas variables
# ("Defina ... en .env.prod"); si además dejara el valor de ejemplo de este archivo, los tres servicios
# se negarían a arrancar por su cuenta (app/core/config_guard.py, el mismo guardia que ya protege
# docker-compose.yml fuera de APP_ENV=development).
#
# Genere cada contraseña y la clave JWT con algo como:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Superusuario de la instancia de PostgreSQL (solo lo usa el administrador; ningún servicio se conecta
# con él, ver infra/postgres/roles.sql).
POSTGRES_PASSWORD=CAMBIAR_ESTE_VALOR

# Contraseñas de los roles propios de auth-service y fleet-core-service (infra/postgres/roles.sql).
AUTH_DB_PASSWORD=CAMBIAR_ESTE_VALOR
FLEET_DB_PASSWORD=CAMBIAR_ESTE_VALOR

# Clave simétrica (HS256) con la que auth-service firma los JWT y los otros dos servicios los
# verifican: debe ser la MISMA en los tres, de al menos 32 caracteres y aleatoria.
JWT_SECRET_KEY=CAMBIAR_ESTE_VALOR

# Contraseña inicial del administrador sembrado (auth-service/app/seed.py). Con APP_ENV=production el
# sembrado la exige y obliga a cambiarla en el primer ingreso (RNF-02/RNF-03).
ADMIN_INITIAL_PASSWORD=CAMBIAR_ESTE_VALOR

# Origen público por el que se sirve el sitio (para CORS y las cabeceras de seguridad). En esta
# verificación local es https://localhost; en un despliegue real, el dominio real con https://.
PUBLIC_ORIGIN=https://localhost
