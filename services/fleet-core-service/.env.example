SERVICE_NAME=fleet-core-service
POSTGRES_USER=flota
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=flota_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SCHEMA=fleet

# Debe coincidir con el de auth-service: los JWT que este servicio recibe
# fueron firmados allá; se verifican aquí sin llamar de vuelta a auth-service
# (clave simétrica HS256 compartida entre servicios).
JWT_SECRET_KEY=changeme_local_only
JWT_ALGORITHM=HS256

# Orígenes autorizados a llamar esta API desde el navegador (CORS).
CORS_ORIGINS=http://localhost:5173
