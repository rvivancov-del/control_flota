SERVICE_NAME=reporting-service

# "development" solo en un equipo local; fuera de él el servicio no arranca con secretos por defecto (RNF-02).
APP_ENV=development

# Este servicio NO tiene tablas propias: agrega datos consultando a
# fleet-core-service por HTTP (ver app/core/fleet_client.py), reenviando el
# mismo token del usuario. El esquema "reporting" queda reservado para el
# futuro (p. ej. reportes materializados), no se usa todavía.
FLEET_SERVICE_BASE_URL=http://fleet-core-service:8000

# Debe coincidir con el de auth-service y fleet-core-service.
JWT_SECRET_KEY=changeme_local_only
JWT_ALGORITHM=HS256

# Orígenes autorizados a llamar esta API desde el navegador (CORS).
CORS_ORIGINS=http://localhost:5173
