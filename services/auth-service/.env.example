SERVICE_NAME=auth-service

# Entorno: "development" solo en un equipo local. Si APP_ENV falta o vale otra cosa (p. ej.
# "production"), el servicio NO arranca con la clave JWT ni la contraseña de base de datos por
# defecto (RNF-02), ni siembra el administrador con la clave de la documentación.
APP_ENV=development
POSTGRES_USER=flota
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_DB=flota_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SCHEMA=auth

JWT_SECRET_KEY=changeme_local_only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# RNF-03: tras LOGIN_MAX_FAILED_ATTEMPTS contraseñas incorrectas seguidas la cuenta se bloquea
# LOGIN_LOCKOUT_MINUTES minutos (se desbloquea sola, o un administrador la desbloquea antes).
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Orígenes autorizados a llamar esta API desde el navegador (CORS).
CORS_ORIGINS=http://localhost:5173

# Usuario administrador sembrado automáticamente si no existe (ver app/seed.py).
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=Admin1234
